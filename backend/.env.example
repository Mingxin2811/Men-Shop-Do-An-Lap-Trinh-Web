PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mens_fashion_shop?schema=public
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/payment-success
STRIPE_CANCEL_URL=http://localhost:5173/payment-cancel

# Resend email API is preferred for deploy. Use a verified domain for real recipients.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=Men's Shop <onboarding@resend.dev>
MAIL_TIMEOUT_MS=15000

# Optional Gmail SMTP fallback. SMTP_PASS la App Password 16 ky tu, khong phai mat khau Gmail.
MAIL_FROM=Men's Shop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TIMEOUT_MS=15000
SMTP_USER=
SMTP_PASS=
EMAIL_DEV_MODE=false
OTP_EXPOSE_IN_RESPONSE=false
